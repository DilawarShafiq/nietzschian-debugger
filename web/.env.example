# Optional retained Express API only; the chat UI uses a temporary browser key.
# Never put a key in a VITE_ variable.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
GREENPT_API_KEY=
GREENPT_MODEL=mistral-small-3.2-24b-instruct-2506
# Required (min. 32 characters) when ALLOW_SERVER_KEY=true.
BACKEND_ACCESS_TOKEN=
PORT=3080
# Keep this demo local. It has no login and is not suitable for public deployment.
HOST=127.0.0.1

# Optional cross-origin API clients (not the chat UI):
# FRONTEND_ORIGIN=https://bartvanderwal.github.io
# HOST=0.0.0.0
# ALLOW_SERVER_KEY=false
# Frontend build options (these are public, NOT secrets):
# BASE_PATH=/nietzschian-diagnoser/
# Optional GreenPT backend route for frontend builds (public URL, NOT a key):
# VITE_API_BASE_URL=https://your-backend.example.com
